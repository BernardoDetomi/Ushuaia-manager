rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isLegacyOwner() {
      return signedIn() && (
        request.auth.token.email == 'bernardomd01@gmail.com' ||
        (
          exists(/databases/$(database)/documents/trips/ushuaia-2026) &&
          get(/databases/$(database)/documents/trips/ushuaia-2026).data.ownerUid == request.auth.uid
        )
      );
    }

    function isTripMember(tripId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberUids;
    }

    function isTripOwner(tripId) {
      return signedIn() && get(/databases/$(database)/documents/trips/$(tripId)).data.ownerUid == request.auth.uid;
    }

    function isSplitMember(groupId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/split_groups/$(groupId)).data.memberUids;
    }

    function isSplitOwner(groupId) {
      let group = get(/databases/$(database)/documents/split_groups/$(groupId)).data;
      return signedIn() && (group.ownerUid == request.auth.uid || group.createdBy == request.auth.uid);
    }

    function isResourceOwner(type, resourceId) {
      return (type == 'trip' && isTripOwner(resourceId)) ||
        (type == 'split' && isSplitOwner(resourceId));
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /trips/{tripId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.auth.uid in request.resource.data.memberUids;
      allow update, delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /{subcollection}/{documentId} {
        allow read: if isTripMember(tripId);
        allow create: if isTripMember(tripId) && request.resource.data.createdBy == request.auth.uid;
        allow update, delete: if isTripOwner(tripId);
      }
    }

    match /split_groups/{groupId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.auth.uid in request.resource.data.memberUids;
      allow update, delete: if signedIn()
        && (resource.data.ownerUid == request.auth.uid || resource.data.createdBy == request.auth.uid);

      match /{subcollection}/{documentId} {
        allow read: if isSplitMember(groupId);
        allow create: if isSplitMember(groupId) && request.resource.data.createdBy == request.auth.uid;
        allow update, delete: if isSplitOwner(groupId);
      }
    }

    match /invite_links/{token} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && isResourceOwner(request.resource.data.resourceType, request.resource.data.resourceId);
      allow update: if false;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /join_requests/{requestId} {
      allow read: if signedIn() && (resource.data.userUid == request.auth.uid || resource.data.ownerUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.userUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && get(/databases/$(database)/documents/invite_links/$(request.resource.data.token)).data.active == true
        && get(/databases/$(database)/documents/invite_links/$(request.resource.data.token)).data.ownerUid == request.resource.data.ownerUid;
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow delete: if false;
    }

    // Read-only backup of the original global Ushuaia structure. Only the
    // original owner may access it while the non-destructive migration runs.
    match /expenses/{documentId} { allow read, write: if isLegacyOwner(); }
    match /activities/{documentId} { allow read, write: if isLegacyOwner(); }
    match /checklist/{documentId} { allow read, write: if isLegacyOwner(); }
    match /settings/{documentId} { allow read, write: if isLegacyOwner(); }
  }
}
